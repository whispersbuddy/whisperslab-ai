# Both /api/contact and /api/newsletter send a notification email via
# Resend to CONTACT_NOTIFY_EMAIL (newsletter no longer uses a Resend
# Audience — see CLAUDE.md). CONTACT_FROM_EMAIL must be on a domain
# verified at resend.com/domains — whisperslab.com is verified, so use an
# address on that domain here, not Resend's onboarding@resend.dev sandbox
# sender (which only delivers to the Resend account owner's own email).
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=hello@whisperslab.com
CONTACT_FROM_EMAIL=Whispers Lab <hello@whisperslab.com>

# Calendly event-type URLs used by the inline booking embeds (Home #book,
# Audit #book, /booking-confirmed). Falls back to placeholder URLs if unset,
# so the site still builds/runs — but the widget will show Calendly's
# "page not found" until real event links are set here.
# Discovery call — used on the Home and Automation Audit pages.
NEXT_PUBLIC_CALENDLY_DISCOVERY_URL=
# Scope-the-build call — used on the hidden /booking-confirmed page reached
# after submitting the Contact form (the Core Build funnel's gate).
NEXT_PUBLIC_CALENDLY_SCOPE_URL=
